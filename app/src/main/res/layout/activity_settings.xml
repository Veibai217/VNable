<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/game_sys_btn"
            android:layout_marginHorizontal="@dimen/game_sys_bar_end"
            android:layout_marginTop="@dimen/game_sys_bar_top"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/action_back"
                android:focusable="true"
                android:padding="9dp"
                android:src="@drawable/ic_back"
                app:tint="?attr/vnTextSecondary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/settings_title"
                android:textAppearance="@style/TextAppearance.VN.ModalTitle" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/modal_side_pad"
            android:layout_marginTop="18dp"
            android:text="@string/settings_group_theme"
            android:textAppearance="@style/TextAppearance.VN.SectionLabel" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/modal_side_pad"
            android:layout_marginTop="14dp"
            android:text="@string/settings_theme"
            android:textAppearance="@style/TextAppearance.VN.ListTitle" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/modal_side_pad"
            android:layout_marginTop="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/box_theme_swatches"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingEnd="10dp" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/tv_theme_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/modal_side_pad"
            android:layout_marginTop="8dp"
            android:textAppearance="@style/TextAppearance.VN.ListSub" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/modal_side_pad"
            android:layout_marginTop="14dp"
            android:text="@string/settings_language"
            android:textAppearance="@style/TextAppearance.VN.ListTitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginHorizontal="@dimen/modal_side_pad"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_segment_track"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/seg_lang_system"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/lang_system"
                android:textColor="?attr/vnTextSecondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/seg_lang_zh"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/lang_zh"
                android:textColor="?attr/vnTextSecondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/seg_lang_en"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/lang_en"
                android:textColor="?attr/vnTextSecondary"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/modal_side_pad"
            android:layout_marginTop="24dp"
            android:text="@string/settings_group_text"
            android:textAppearance="@style/TextAppearance.VN.SectionLabel" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/modal_side_pad"
            android:layout_marginTop="14dp"
            android:text="@string/settings_text_speed"
            android:textAppearance="@style/TextAppearance.VN.ListTitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginHorizontal="@dimen/modal_side_pad"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_segment_track"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/seg_speed_slow"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/speed_slow"
                android:textColor="?attr/vnTextSecondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/seg_speed_normal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/speed_normal"
                android:textColor="?attr/vnTextSecondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/seg_speed_fast"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/speed_fast"
                android:textColor="?attr/vnTextSecondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/seg_speed_instant"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/speed_instant"
                android:textColor="?attr/vnTextSecondary"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/modal_side_pad"
            android:layout_marginTop="18dp"
            android:text="@string/settings_font_size"
            android:textAppearance="@style/TextAppearance.VN.ListTitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginHorizontal="@dimen/modal_side_pad"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_segment_track"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/seg_font_small"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/font_small"
                android:textColor="?attr/vnTextSecondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/seg_font_standard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/font_standard"
                android:textColor="?attr/vnTextSecondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/seg_font_large"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/font_large"
                android:textColor="?attr/vnTextSecondary"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/modal_side_pad"
            android:layout_marginTop="24dp"
            android:text="@string/settings_group_audio"
            android:textAppearance="@style/TextAppearance.VN.SectionLabel" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/modal_side_pad"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_audio"
                app:tint="?attr/vnTextSecondary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/settings_audio"
                android:textAppearance="@style/TextAppearance.VN.ListTitle" />

            <com.Veibai.VNable.ui.SoftSwitch
                android:id="@+id/sw_audio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/modal_side_pad"
            android:layout_marginTop="24dp"
            android:text="@string/settings_group_about"
            android:textAppearance="@style/TextAppearance.VN.SectionLabel" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/modal_side_pad"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_version"
                android:textAppearance="@style/TextAppearance.VN.ListTitle" />

            <TextView
                android:id="@+id/tv_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.VN.ListSub" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
